# CMRE — environment configuration
# Copy to .env and fill in the values you have.

# --- Database --------------------------------------------------------------
CMRE_DATABASE_URL=postgresql+psycopg://cmre:cmre@localhost:5432/cmre
CMRE_DATABASE_ECHO=false

# --- Cloud LLMs (optional) ------------------------------------------------
CMRE_GEMINI_API_KEY=
CMRE_GEMINI_MODEL=gemini-3-flash
CMRE_DEEP_RESEARCH_MODEL=gemini-3-pro

# --- Antigravity CLI (default local LLM) ----------------------------------
CMRE_ANTIGRAVITY_BASE_URL=http://127.0.0.1:4317
CMRE_ANTIGRAVITY_MODEL=antigravity-local
CMRE_ANTIGRAVITY_TIMEOUT_SECONDS=60
CMRE_ANTIGRAVITY_FALLBACK_TO_GEMINI=false

# --- Jules cloud coding agent ---------------------------------------------
CMRE_JULES_API_BASE=https://jules.googleapis.com/v1alpha
CMRE_JULES_API_KEY=
CMRE_JULES_FREE_TIER_DAILY_LIMIT=15
CMRE_JULES_CONCURRENT_LIMIT=3

# --- Connectors -----------------------------------------------------------
CMRE_CONNECTOR_HUGGINGFACE_ENABLED=true
CMRE_CONNECTOR_SEMANTIC_SCHOLAR_ENABLED=true
CMRE_CONNECTOR_ARXIV_ENABLED=true
CMRE_CONNECTOR_GITHUB_ENABLED=true
CMRE_CONNECTOR_KAGGLE_ENABLED=true

# --- GitHub / repo -------------------------------------------------------
CMRE_GITHUB_TOKEN=
CMRE_GITHUB_REPO=your-org/cmre-engine
CMRE_CREATE_GITHUB_ISSUES=false

# --- Gemini Spark (planning + Drive) -------------------------------------
CMRE_SPARK_DRIVE_FOLDER_ID=
CMRE_SPARK_DOCS_EXPORT_FORMAT=markdown

# --- Policies ------------------------------------------------------------
CMRE_ALLOW_UNKNOWN_LICENSE_IN_REPORTS=false
CMRE_MAX_ARTIFACTS_PER_RUN=25
CMRE_MAX_CLAIMS_PER_REPORT=20

# --- Embeddings ----------------------------------------------------------
CMRE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CMRE_EMBEDDING_DIM=384

# --- Recency decay -------------------------------------------------------
CMRE_EVIDENCE_HALF_LIFE_DAYS=365
